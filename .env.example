# ==============================================================================
# GroundTruth Environment Configuration Template
# Copy this file to '.env' and populate with your local values/API keys.
# ==============================================================================

# Core Application Settings
ENVIRONMENT=development
PROJECT_NAME="GroundTruth"
API_V1_STR=/api/v1
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=groundtruth
POSTGRES_PASSWORD=groundtruth_dev_secret
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=groundtruth

# In-Memory Cache (Redis 7)
REDIS_HOST=redis
REDIS_PORT=6379

# External Flight Data Ingestion (AeroDataBox via RapidAPI)
# Set MOCK_INGESTION=false to enable live API calls; true to use local JSON replay
MOCK_INGESTION=false
AERODATABOX_API_KEY=your_rapidapi_key_here
AERODATABOX_API_HOST=aerodatabox.p.rapidapi.com

# Live Transponder Feeds (OpenSky Network - Optional Authenticated Access)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# FAA NAS Status Service (Airspace & Ground Stops - Public Free Feed)
FAA_NAS_API_URL=https://nasstatus.faa.gov/api/airport-status-information

# Proactive Push Notification Service (Twilio SMS - Optional)
TWILIO_ACCOUNT_SID=mock_sid
TWILIO_AUTH_TOKEN=mock_token
TWILIO_PHONE_NUMBER=+15550001234
